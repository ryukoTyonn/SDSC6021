{"contents": [{"role": "user", "parts": [{"text": "\u751f\u6210\u4e00\u5f20\u8fd0\u52a8\u88c5\u5907\u5c55\u793a\u56fe\u3002\u6d45\u7070\u5730\u9762\u4e0a\u6070\u597d\u6709\u4e00\u53cc\u767d\u8272\u8dd1\u978b\uff0c\u978b\u5b50\u6b63\u524d\u65b9\u662f\u4e00\u53ea\u84dd\u8272\u6c34\u58f6\uff0c\u6c34\u58f6\u53f3\u4fa7\u662f\u4e00\u6761\u6a59\u8272\u6bdb\u5dfe\u3002\u80cc\u666f\u4e3a\u7eaf\u767d\u8272\uff0c\u6240\u6709\u7269\u54c1\u5b8c\u6574\u53ef\u89c1\uff0c\u5de6\u4e0a\u65b9\u7559\u767d\u3002\u753b\u9762\u4e2d\u4e0d\u8981\u51fa\u73b0\u4eba\u7269\uff0c\u4e5f\u4e0d\u8981\u5728\u6c34\u58f6\u3001\u978b\u5b50\u3001\u6bdb\u5dfe\u6216\u80cc\u666f\u4e0a\u51fa\u73b0\u54c1\u724c\u6807\u8bc6\u3001\u6807\u7b7e\u3001\u523b\u5ea6\u3001\u5b57\u6bcd\u6216\u4efb\u4f55\u53ef\u89c1\u6587\u5b57\u3002"}]}], "generationConfig": {"responseModalities": ["IMAGE"]}}