{"contents": [{"role": "user", "parts": [{"text": "\u7b80\u6d01\u65e9\u9910\u6d77\u62a5\u5e95\u56fe\u3002\u6d45\u8272\u539f\u6728\u9910\u684c\u4e0a\u6446\u653e\u4e00\u4e2a\u767d\u8272\u9676\u74f7\u5706\u76d8\uff0c\u76d8\u5185\u6574\u9f50\u6446\u653e\u4e24\u7247\u5410\u53f8\u548c\u4e00\u4e2a\u5b8c\u6574\u5355\u9762\u714e\u86cb\u3002\u76d8\u5b50\u53f3\u4fa7\u653e\u6709\u4e00\u676f\u660e\u4eae\u7684\u9c9c\u69a8\u6a59\u6c41\u3002\u80cc\u666f\u4e3a\u5927\u9762\u79ef\u7eaf\u51c0\u5976\u6cb9\u8272\u5899\u9762\uff0c\u753b\u9762\u4e0a\u65b9\u4fdd\u7559\u5145\u88d5\u7559\u767d\uff0c\u5149\u7ebf\u67d4\u548c\u81ea\u7136\uff0c\u65e0\u4efb\u4f55\u6587\u5b57\u4e0e\u6742\u7269\u3002"}]}], "generationConfig": {"responseModalities": ["IMAGE"]}}