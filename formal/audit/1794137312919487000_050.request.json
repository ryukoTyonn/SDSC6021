{"contents": [{"role": "user", "parts": [{"text": "\u751f\u6210\u4e00\u5f20\u8336\u5177\u9759\u7269\u914d\u56fe\u3002\u6df1\u8272\u6728\u684c\u4e0a\u6070\u597d\u6709\u4e00\u4e2a\u767d\u8272\u8336\u58f6\u548c\u4e24\u4e2a\u5c0f\u8336\u676f\uff1b\u8336\u58f6\u4f4d\u4e8e\u4e24\u4e2a\u8336\u676f\u540e\u65b9\uff0c\u5de6\u4fa7\u8336\u676f\u4e3a\u84dd\u8272\uff0c\u53f3\u4fa7\u8336\u676f\u4e3a\u767d\u8272\u3002\u80cc\u666f\u4e3a\u6d45\u7c73\u8272\uff0c\u4e0d\u8981\u51fa\u73b0\u8336\u53f6\u5305\u88c5\u3001\u6587\u5b57\u6216\u4eba\u7269\u3002"}]}], "generationConfig": {"responseModalities": ["IMAGE"]}}